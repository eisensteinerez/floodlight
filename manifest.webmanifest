{
  "id": "/",
  "name": "Floodlight",
  "short_name": "Floodlight",
  "description": "Live scores, player research, predictions and alerts for the teams and players you follow.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0A0D12",
  "theme_color": "#0A0D12",
  "categories": ["sports"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Live", "url": "/#/live", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Your day", "url": "/#/today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Predictions", "url": "/#/predictions", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Alerts", "url": "/#/inbox", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
