{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{*.py,*.html,*.js,*.css,*.webmanifest,icons/*.png}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/tick", "schedule": "0 7 * * *" },
    { "path": "/api/cron/tick", "schedule": "0 14 * * *" }
  ]
}
